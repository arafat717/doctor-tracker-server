model Doctor {
  id             String    @id @default(uuid())
  name           String
  specialization String
  hospital       String
  phone          String
  email          String    @unique
  patients       Patient[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
  @@index([specialization])
  @@index([hospital])
  @@index([createdAt])
  @@map("doctors")
}
